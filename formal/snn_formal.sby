# =============================================================================
# snn_formal.sby — SymbiYosys formal verification script
#
# Proves 9 safety properties across ConvPE, LineBuffer, and TimeStep_FSM
# using bounded model checking (depth=20 cycles).
#
# Usage:
#   conda install -c conda-forge symbiyosys   # one-time setup
#   make formal                               # runs this file
#   # or directly: sby -f formal/snn_formal.sby
#
# Engines: smtbmc with Bitwuzla solver (fast, bit-precise arithmetic)
# =============================================================================

[tasks]
conv_pe
line_buffer
timestep_fsm

# --- ConvPE task -------------------------------------------------------------
[conv_pe]
mode prove
depth 20

[engines conv_pe]
smtbmc bitwuzla

[script conv_pe]
read -formal rtl/cells/ClockGate.sv
read -formal rtl/core/ConvPE.sv
prep -top ConvPE -nordff
setattr -unset keep_hierarchy

[files conv_pe]
rtl/cells/ClockGate.sv
rtl/core/ConvPE.sv

# --- LineBuffer task ---------------------------------------------------------
[line_buffer]
mode prove
depth 40

[engines line_buffer]
smtbmc bitwuzla

[script line_buffer]
read -formal rtl/core/LineBuffer.sv
prep -top LineBuffer -nordff

[files line_buffer]
rtl/core/LineBuffer.sv

# --- TimeStep_FSM task -------------------------------------------------------
[timestep_fsm]
mode prove
depth 700

[engines timestep_fsm]
smtbmc bitwuzla

[script timestep_fsm]
read -formal rtl/core/TimeStep_FSM.sv
prep -top TimeStep_FSM -nordff

[files timestep_fsm]
rtl/core/TimeStep_FSM.sv
