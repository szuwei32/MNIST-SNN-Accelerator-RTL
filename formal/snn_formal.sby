# =============================================================================
# snn_formal.sby — SymbiYosys formal verification script
#
# Verifies 6 safety properties (immediate assertions) across two control
# blocks:
#   LineBuffer   — 3 properties (col range, row range, valid-after-warmup)
#   TimeStep_FSM — 3 properties (addr range, frame range, frame_done pulse)
#
# mode prove = unbounded proof (BMC base case + temporal k-induction),
# not just bounded model checking. depth bounds the BMC base case.
#
# Usage:  sby -f formal/snn_formal.sby   (or: make formal)
# Engine: smtbmc with the Bitwuzla SMT solver.
# =============================================================================

[tasks]
line_buffer
timestep_fsm

[options]
mode prove
depth 30

[engines]
smtbmc boolector

[script]
line_buffer:  read_verilog -sv -formal -DFORMAL LineBuffer.sv
line_buffer:  prep -top LineBuffer -nordff
timestep_fsm: read_verilog -sv -formal -DFORMAL TimeStep_FSM.sv
timestep_fsm: prep -top TimeStep_FSM -nordff

[files]
line_buffer:  rtl/core/LineBuffer.sv
timestep_fsm: rtl/core/TimeStep_FSM.sv
